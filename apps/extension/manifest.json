{
  "manifest_version": 3,
  "name": "Curio — lector contextual",
  "version": "1.0.0",
  "description": "Selecciona o pulsa una palabra en cualquier página y ve su descripción ahí mismo. Local, vía Ollama.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["http://localhost:11434/*"],
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "action": {
    "default_title": "Curio",
    "default_popup": "src/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.tsx"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-curio": {
      "suggested_key": { "default": "Alt+C" },
      "description": "Activar/desactivar Curio en esta página"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
