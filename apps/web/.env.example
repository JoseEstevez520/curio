# Copy to `.env.local` (gitignored) and fill in. Optional — the UI header works too.
# NOTE: VITE_* vars are inlined into the client bundle at build time, so treat any key
# here as dev-only. Never build/deploy a production bundle with a real key baked in.

# Your Groq (OpenAI-compatible) API key. With this set, the app starts on Groq.
VITE_GROQ_API_KEY=

# Optional model override (defaults to llama-3.3-70b-versatile).
VITE_GROQ_MODEL=llama-3.3-70b-versatile

# Optional starting brain: 'groq' or 'ollama'.
VITE_BRAIN=groq
