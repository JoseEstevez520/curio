# Copy to `.env.local` (gitignored) and fill in — ALL OPTIONAL. Everything here can also be set
# from the app's settings menu (Ajustes → Cerebro: Nube), which is the normal way for others.
# NOTE: VITE_* vars are inlined into the client bundle at build time, so treat any key here as
# dev-only. Never build/deploy a production bundle with a real key baked in.

# Cloud endpoint base URL (ANY OpenAI-compatible API). Defaults to Groq's fast free tier.
# Examples: https://api.groq.com/openai/v1 · https://openrouter.ai/api/v1 · http://localhost:8080/v1
VITE_CLOUD_BASE_URL=https://api.groq.com/openai/v1

# Your API key for that endpoint. With this set, the app starts on the cloud brain.
VITE_GROQ_API_KEY=

# Model id — must exist on the endpoint you chose. Groq's lineup changes often (older Llama models
# were deprecated), so check console.groq.com/docs/models for a current one.
VITE_GROQ_MODEL=openai/gpt-oss-20b

# Optional starting brain: 'groq' (cloud) or 'ollama' (local). Without a key, defaults to ollama.
VITE_BRAIN=groq
