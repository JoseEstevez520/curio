{
  "name": "curio-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Curio — local-first reading companion. Monorepo: portable core + web app + browser extension.",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev": "npm -w @curio/web run dev",
    "build": "npm -w @curio/web run build",
    "build:ext": "npm -w @curio/extension run build",
    "dev:landing": "npm -w @curio/landing run dev",
    "build:landing": "npm -w @curio/landing run build",
    "preview": "npm -w @curio/web run preview",
    "typecheck": "npm -w @curio/web run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vitest": "^4.1.10"
  }
}
